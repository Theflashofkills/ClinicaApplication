<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".DevHealthyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevHealthy"
        tools:targetApi="31">

    <!-- Tela inicial será o Login -->
    <activity
        android:name=".LoginActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

    <!-- Telas do app -->
    <activity android:name=".MainActivity" />
    <activity android:name=".CadastroUsuarioActivity" />
    <activity android:name=".EsqueceuSenhaActivity" />
    <activity android:name=".CadastroExameActivity" />
    <activity android:name=".CadastroPacienteActivity" />
    <activity android:name=".ListaPacientesActivity" />
</application>

    </manifest>
